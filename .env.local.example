# Профиль разработчика: бэкенд и фронтенд на хосте → инфраструктура в докере.
#
#   pnpm infra                        # поднять mongo / sqs / garage
#   cp .env.local.example .env.local  # включить этот профиль
#   pnpm seed                         # пользователь seed@fuse.local
#   pnpm dev                          # фронт, бэк и воркер на хосте
#
# Это единственный рабочий файл окружения. Общий .env из репозитория удалён
# вместе с кредами внешних сервисов: внешней инфраструктуры у проекта больше
# нет, всё поднимается локально. Переменные, которых здесь нет, берут значения
# по умолчанию из схем (apps/backend/src/config/env.schema.ts и
# apps/frontend/config/env.schema.ts); полный список — в .env.example.
#
# .env.local в .gitignore. Единственное, что здесь нужно заполнить руками, —
# два секрета в конце файла; всё остальное это дефолты локальных контейнеров.

# MongoDB (docker-compose.dev.yml, порт 27018 — чтобы не конфликтовать с
# системным mongod на 27017).
MONGODB_URL=mongodb://fuse:fusepassword@localhost:27018/fuse?authSource=admin

# SQS через LocalStack. Очередь scenario-execution (+ DLQ) создаётся автоматически
# при старте контейнера, см. docker/localstack/init-sqs.sh.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_SQS_QUEUE_URL=http://localhost:4566/000000000000/scenario-execution
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Параллелизм локального воркера (pnpm dev:worker). 1–10, по умолчанию 5.
WORKER_CONCURRENCY=5
# Garage (S3-совместимое хранилище). S3_PORT обязателен: порт нестандартный,
# из схемы http:// его не вывести. Бакет и ключ доступа создаются самим Garage
# при первом старте (--single-node --default-bucket), отдельного бутстрапа нет.
#
# S3_SECRET_KEY не короче 16 символов: с более коротким Garage не стартует
# («Secret keys should be at least 16 characters long»).
S3_URL=localhost
S3_PORT=9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=fuse-local-dev-secret
S3_BUCKET=fuse

# Хосты в обход SSRF-блок-листа: api-шаги сид-сценария бьют по мок-API на
# localhost:8085. Список обходит и блок-лист, и резолв DNS — в боевом окружении
# он должен быть пустым.
SSRF_ALLOWED_HOSTS=localhost,127.0.0.1

# Локальный вход по логину и паролю, в обход Yandex OAuth. Нужен, когда
# OAuth-кредов нет: иначе в браузере войти нечем.
#
# Пара задаётся ТОЛЬКО на машине разработчика. Пока DEV_LOGIN_PASSWORD пуст,
# маршрут /api/auth/dev-login отвечает 404. Непустое значение вместе с
# NODE_ENV=production роняет бэкенд на старте — это сделано намеренно, чтобы
# пара, забытая в .env, не открыла вход в бою.
#
# Логин должен совпадать с email пользователя в локальной БД: `pnpm seed`
# заводит seed@fuse.local. Пароль нигде не хранится, сверка идёт с этим значением.
DEV_LOGIN_EMAIL=seed@fuse.local
DEV_LOGIN_PASSWORD=fuse-local-dev-login

# ─── Секреты приложения ───────────────────────────────────────────────────────
# Сгенерировать каждый отдельной командой:
#
#   openssl rand -hex 48
#
# Два РАЗНЫХ значения. Одно на обе роли означает, что компрометация сессии Nuxt
# даёт возможность подписывать токены доступа.
JWT_SECRET=<openssl rand -hex 48>
NUXT_SESSION_SECRET=<openssl rand -hex 48>

# Базовый URL API для фронтенда. В docker compose фронт работает за caddy и
# значение там жёстко задано как "/".
NUXT_PUBLIC_API_BASE_URL=http://localhost:3001
