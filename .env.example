# Образец окружения.
#
# Рабочий профиль разработчика — .env.local (скопируйте .env.local.example).
# Этот файл нужен двум вещам: показать полный список переменных со значениями
# по умолчанию и дать CI набор плейсхолдеров перед typecheck.
#
#   pnpm infra                        # поднять mongo / sqs / garage
#   cp .env.local.example .env.local  # профиль разработчика
#   pnpm seed                         # пользователь seed@fuse.local
#   pnpm dev                          # фронт, бэк и воркер на хосте
#
# Внешней инфраструктуры у проекта нет: всё, что ниже, указывает на контейнеры
# из docker-compose.dev.yml. Если появится боевое развёртывание, его переменные
# задаются в окружении раннера, а не в файле репозитория.

# ─── Backend (apps/backend) ───────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# Хосты в обход SSRF-блок-листа (localhost/.local/приватные IP), через запятую.
# Нужно, чтобы api-шаги били по локальному мок-API (`pnpm infra`, порт 8085).
# Список обходит и блок-лист, и резолв DNS, поэтому в боевом окружении он
# ДОЛЖЕН быть пустым.
SSRF_ALLOWED_HOSTS=localhost,127.0.0.1

# MongoDB. Локальный контейнер (docker-compose.dev.yml) слушает 27018 на хосте —
# порт нестандартный, чтобы не конфликтовать с системным mongod на 27017.
MONGODB_URL=mongodb://fuse:fusepassword@localhost:27018/fuse?authSource=admin

# SQS-совместимая очередь исполнения сценариев. Локально — LocalStack; очередь
# scenario-execution и DLQ создаются при старте контейнера, см.
# docker/localstack/init-sqs.sh. Коду нужен только Queue URL, регион и креды.
AWS_REGION=us-east-1
AWS_SQS_QUEUE_URL=http://localhost:4566/000000000000/scenario-execution
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566

# Сколько запусков держит ОДИН воркер-процесс (1–10 — лимит выборки SQS).
# Больше параллелизма — числом воркеров: docker compose up -d --scale worker=N.
WORKER_CONCURRENCY=5

# S3-совместимое файловое хранилище. Локально — Garage: S3_PORT обязателен,
# порт нестандартный и из схемы http:// не выводится. Для хранилища с TLS на
# стандартном порту достаточно полного URL в S3_URL, а S3_PORT оставить пустым.
S3_URL=localhost
S3_PORT=9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=fuse-local-dev-secret
S3_BUCKET=fuse

# JWT (сессии пользователей). Сгенерировать: openssl rand -hex 48
JWT_SECRET=<generate-via-openssl-rand-hex-48>
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Yandex OAuth. Пусто = вход через Яндекс недоступен; для входа в браузере
# используйте локальный вход по паролю (DEV_LOGIN_* в .env.local.example).
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:3001/api/auth/callback
# URL фронтенда: куда редиректить пользователя после OAuth-callback,
# и origin для CORS в dev-режиме (cross-origin 5173 -> 3001).
APP_URL=http://localhost:5173

# ─── Лимиты размера файлов ────────────────────────────────────────────────────
# Единый источник дефолтов — apps/backend/src/config/file-limits.constants.ts.
# Порог single vs chunked upload (MB)
FILE_SINGLE_UPLOAD_MAX_MB=10
# Лимит загрузки файла OpenAPI-спеки (MB). Ограничен так, чтобы импорт влезал в
# документ MongoDB (потолок 16 MB).
SPEC_FILE_MAX_MB=15
# Лимит размера ответа при загрузке спеки по URL, SSRF-guard (MB)
SPEC_URL_FETCH_MAX_MB=10

# Структурированное логирование. Непустой LOG_COLLECTOR_URL означает отправку
# записей на внешний приёмник — только по https.
LOG_COLLECTOR_URL=
MONIUM_ENABLED=

# ─── Frontend (apps/frontend) ─────────────────────────────────────────────────
# Публичные переменные (доступны на клиенте) — префикс NUXT_PUBLIC_
# Используется только при локальной разработке. В docker compose фронтенд
# работает за caddy и значение жёстко задано как "/" (same-origin, /api/*
# проксируется в backend).
NUXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Yandex Metrica (пусто = отключено)
NUXT_PUBLIC_YANDEX_METRIKA_ID=

# Порог single vs chunked upload для фронтенда (MB)
FILE_SINGLE_UPLOAD_MAX_MB=10
# Лимит загрузки файла спеки для клиентской валидации в дропзоне (MB)
SPEC_FILE_MAX_MB=15

# Серверные переменные (только SSR) — префикс NUXT_
# Сгенерировать отдельно от JWT_SECRET: одно значение на две роли означает, что
# компрометация сессии Nuxt даёт возможность подписывать токены доступа.
NUXT_SESSION_SECRET=<generate-via-openssl-rand-hex-48>

# ─── Caddy (docker-compose) ───────────────────────────────────────────────────
# Порт, на котором caddy принимает трафик: http://localhost:${HTTP_PORT}
HTTP_PORT=8081
